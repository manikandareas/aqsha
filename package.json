{
  "name": "aqsha",
  "private": true,
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter '@aqsha/web' --filter '@aqsha/www' --filter '@aqsha/api' dev",
    "dev:web": "bun run --filter '@aqsha/web' dev",
    "dev:www": "bun run --filter '@aqsha/www' dev",
    "dev:api": "bun run --filter '@aqsha/api' dev",
    "dev:app": "bun run --filter '@aqsha/app' dev",
    "dev:convex": "bun run --filter '@aqsha/convex' dev",
    "dev:pivot": "bun run --parallel --filter '@aqsha/app' --filter '@aqsha/convex' dev",
    "build": "bun run --filter '@aqsha/web' --filter '@aqsha/www' --filter '@aqsha/api' build",
    "build:www": "bun run --filter '@aqsha/www' build",
    "build:app": "bun run --filter '@aqsha/app' build",
    "lint": "bun run --parallel --filter '@aqsha/web' --filter '@aqsha/api' --filter '@aqsha/shared' --filter '@aqsha/db' lint",
    "typecheck": "bun run --parallel --filter '@aqsha/web' --filter '@aqsha/www' --filter '@aqsha/app' --filter '@aqsha/api' --filter '@aqsha/convex' --filter '@aqsha/shared' --filter '@aqsha/db' --filter '@aqsha/ui' typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/lodash": "^4.17.24",
    "bun-types": "^1.3.13",
    "eslint": "^9.39.1",
    "globals": "^17.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sinclair/typebox": "0.34.49",
    "@tanstack/react-query": "^5.100.1",
    "html2canvas-pro": "^2.0.2",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-lite-youtube-embed": "^3.5.1",
    "react-player": "^3.4.0",
    "react-textarea-autosize": "^8.5.9",
    "react-tweet": "^3.3.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "overrides": {
    "@sinclair/typebox": "0.34.49"
  }
}
