{
  "name": "aqsha",
  "private": true,
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/web",
    "apps/agents",
    "apps/api-v2",
    "apps/web-v2",
    "apps/agent-v2",
    "packages/agent-contracts",
    "packages/chat-core",
    "packages/convex",
    "packages/db",
    "packages/services",
    "packages/ui"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter '@aqsha/app' --filter '@aqsha/convex' --filter '@aqsha/agents' dev",
    "dev:app": "bun run --filter '@aqsha/app' dev",
    "dev:convex": "bun run --filter '@aqsha/convex' dev",
    "build": "bun run --filter '@aqsha/app' build",
    "build:app": "bun run --filter '@aqsha/app' build",
    "dev:agents": "bun run --filter '@aqsha/agents' dev",
    "test:agents": "bun run --filter '@aqsha/agents' --filter '@aqsha/agent-contracts' test",
    "dev:api": "bun run --filter '@aqsha/api-v2' dev",
    "dev:web-v2": "bun run --filter '@aqsha/web-v2' dev",
    "dev:worker": "bun run --filter '@aqsha/api-v2' worker",
    "dev:eve": "bun run --filter '@aqsha/agent-v2' dev",
    "build:v2-dist": "bun run --filter '@aqsha/db' --filter '@aqsha/services' build",
    "watch:v2-dist": "bun run --parallel --filter '@aqsha/db' --filter '@aqsha/services' build:watch",
    "dev:v2": "bun run build:v2-dist && (bun run watch:v2-dist & bun run dev:api & bun run dev:worker & bun run dev:eve & bun run dev:web-v2 & wait)",
    "db:generate": "bun run --filter '@aqsha/db' generate",
    "db:migrate": "bun run --filter '@aqsha/db' migrate",
    "db:studio": "bun run --filter '@aqsha/db' studio",
    "test:v2": "bun run --filter '@aqsha/db' --filter '@aqsha/chat-core' --filter '@aqsha/services' --filter '@aqsha/api-v2' test",
    "lint": "bun run --parallel --filter '@aqsha/app' --filter '@aqsha/convex' --filter '@aqsha/api-v2' --filter '@aqsha/web-v2' lint",
    "typecheck": "bun run --parallel --filter '@aqsha/app' --filter '@aqsha/convex' --filter '@aqsha/ui' --filter '@aqsha/agents' --filter '@aqsha/agent-contracts' --filter '@aqsha/api-v2' --filter '@aqsha/web-v2' --filter '@aqsha/agent-v2' --filter '@aqsha/db' --filter '@aqsha/chat-core' --filter '@aqsha/services' typecheck"
  },
  "overrides": {
    "elysia": "1.4.29"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/lodash": "^4.17.24",
    "bun-types": "^1.3.13",
    "eslint": "^9.39.1",
    "globals": "^17.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0"
  }
}
