{
  "name": "aqsha",
  "private": true,
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/web",
    "apps/agents",
    "packages/agent-contracts",
    "packages/convex",
    "packages/ui"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter '@aqsha/app' --filter '@aqsha/convex' dev",
    "dev:app": "bun run --filter '@aqsha/app' dev",
    "dev:convex": "bun run --filter '@aqsha/convex' dev",
    "build": "bun run --filter '@aqsha/app' build",
    "build:app": "bun run --filter '@aqsha/app' build",
    "dev:agents": "bun run --filter '@aqsha/agents' dev",
    "test:agents": "bun run --filter '@aqsha/agents' --filter '@aqsha/agent-contracts' test",
    "lint": "bun run --parallel --filter '@aqsha/app' --filter '@aqsha/convex' lint",
    "typecheck": "bun run --parallel --filter '@aqsha/app' --filter '@aqsha/convex' --filter '@aqsha/ui' --filter '@aqsha/agents' --filter '@aqsha/agent-contracts' typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/lodash": "^4.17.24",
    "bun-types": "^1.3.13",
    "eslint": "^9.39.1",
    "globals": "^17.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0"
  },
  "dependencies": {}
}
