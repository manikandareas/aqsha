{
  "name": "aqsha",
  "private": true,
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/agent",
    "packages/chat-core",
    "packages/db",
    "packages/services",
    "packages/ui"
  ],
  "scripts": {
    "dev": "bun run build:dist && (bun run watch:dist & bun run dev:api & bun run dev:worker & bun run dev:agent & bun run dev:web & wait)",
    "dev:api": "bun run --filter '@aqsha/api' dev",
    "dev:web": "bun run --filter '@aqsha/web' dev",
    "dev:worker": "bun run --filter '@aqsha/api' worker",
    "dev:agent": "bun run --filter '@aqsha/agent' dev",
    "infra:up": "docker compose -f infra/compose.dev.yaml up -d",
    "infra:down": "docker compose -f infra/compose.dev.yaml down",
    "infra:obs": "docker compose -f infra/compose.dev.yaml --profile langfuse up -d",
    "build": "bun run build:dist && bun run --filter '@aqsha/agent' build && bun run --filter '@aqsha/web' build",
    "build:dist": "bun run --filter '@aqsha/db' --filter '@aqsha/services' build",
    "watch:dist": "bun run --parallel --filter '@aqsha/db' --filter '@aqsha/services' build:watch",
    "start:api": "bun run --filter '@aqsha/api' start",
    "start:worker": "bun run --filter '@aqsha/api' worker:start",
    "start:agent": "bun run --filter '@aqsha/agent' start",
    "start:web": "bun run --filter '@aqsha/web' start",
    "stats:snapshot": "bun run --filter '@aqsha/services' stats:snapshot",
    "stats:smoke": "bun run --filter '@aqsha/services' stats:smoke",
    "db:generate": "bun run --filter '@aqsha/db' generate",
    "db:migrate": "bun run --filter '@aqsha/db' migrate",
    "db:studio": "bun run --filter '@aqsha/db' studio",
    "test": "bun run --filter '@aqsha/db' --filter '@aqsha/chat-core' --filter '@aqsha/services' --filter '@aqsha/api' test",
    "lint": "bun run --parallel --filter '@aqsha/api' --filter '@aqsha/web' lint",
    "typecheck": "bun run --parallel --filter '@aqsha/ui' --filter '@aqsha/api' --filter '@aqsha/web' --filter '@aqsha/agent' --filter '@aqsha/db' --filter '@aqsha/chat-core' --filter '@aqsha/services' typecheck"
  },
  "overrides": {
    "elysia": "1.4.29",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/lodash": "^4.17.24",
    "bun-types": "^1.3.13",
    "eslint": "^9.39.1",
    "globals": "^17.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0"
  }
}
