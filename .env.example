# ══════════════════════════════════════════════════════════════════════════════
# Aqsha — env produksi (Dokploy, SATU environment untuk seluruh stack).
#
# Salin isi file ini ke tab **Environment** service Compose di Dokploy. Semua nilai
# di-referensikan `compose.yaml` root via ${VAR}; wiring antar-service (DB/Redis/S3
# internal, MASTRA_AGENT_ORIGIN) sudah fixed di compose — TIDAK perlu diset di sini.
# Runbook lengkap: DEPLOYMENT.md. Untuk dev lokal pakai .env per-app
# (apps/*/.env.example) + infra/compose.dev.yaml, BUKAN file ini.
# ══════════════════════════════════════════════════════════════════════════════

# ── Infra (Postgres / Redis / MinIO — dipakai membangun URL internal) ─────────
POSTGRES_PASSWORD=changeme_strong_password
REDIS_PASSWORD=changeme_redis_password
MINIO_ROOT_USER=aqsha
MINIO_ROOT_PASSWORD=changeme_minio_password        # min 8 karakter
# MINIO_BUCKET=aqsha
# Ekspos Postgres ke host (port 5435) untuk Drizzle Studio/psql via Tailscale.
# Default 127.0.0.1 = tidak terekspos. JANGAN pernah 0.0.0.0.
# POSTGRES_BIND_IP=100.x.y.z

# URL PUBLIK MinIO (mis. https://assets.aqshara.com). Presigned upload/download URL
# mewarisi host ini → WAJIB terjangkau browser (bukan minio:9000 internal).
S3_ENDPOINT=https://assets.aqshara.com

# ── Web (NEXT_PUBLIC_* = build arg, di-bake ke bundle klien SEBELUM build pertama;
#    mengubahnya butuh rebuild image web) ──────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.aqshara.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_CHANGEME
# URL kanonik situs (SEO: metadataBase/robots/sitemap/OG), tanpa trailing slash.
# NEXT_PUBLIC_SITE_URL=https://aqshara.com

# ── Clerk (satu Clerk app dibagi web + api + agent) ────────────────────────────
CLERK_SECRET_KEY=sk_live_CHANGEME
# Secret endpoint webhook Clerk POST /webhooks/clerk (Clerk dashboard → Webhooks).
CLERK_WEBHOOK_SIGNING_SECRET=whsec_CHANGEME

# ── Model LLM utama (OpenAI / gateway OpenAI-compatible) ───────────────────────
# Dipakai agent (chat Astra + /deep), api (/blocknote-ai doc-AI), worker (judul thread).
# Astra memakai Responses API utk reasoning summary → pakai model reasoning-capable.
OPENAI_API_KEY=sk-CHANGEME
# OPENAI_BASE_URL=https://gateway.example/v1      # gateway/LiteLLM; bila tanpa Responses API,
#                                                 # set AQSHA_*_REASONING_EFFORT=off
AQSHA_LITE_MODEL=gpt-5.4-mini
# AQSHA_PRO_MODEL=gpt-5.1              # tier Pro; kosong → fallback Lite + billing turun ke rate Lite
# AQSHA_LITE_CONTEXT_WINDOW=128000     # jendela context (token) utk TokenLimiter (input ~75%)
# AQSHA_PRO_CONTEXT_WINDOW=200000
# AQSHA_LITE_REASONING_EFFORT=low      # minimal|low|medium|high|xhigh|off
# AQSHA_PRO_REASONING_EFFORT=high
# AQSHA_REASONING_SUMMARY=auto         # auto|concise|detailed
# AQSHA_TITLE_MODEL=gpt-4o-mini        # auto-title thread (worker), tugas murah

# ── Fast model (saran kueri typeahead /explore/suggest) — instance murah TERPISAH ─
AQSHA_FAST_MODEL_API_KEY=sk-CHANGEME
# AQSHA_FAST_MODEL_BASE_URL=https://gateway.example/v1
# AQSHA_FAST_MODEL=gpt-4o-mini

# ── RAG embedding (index + search HARUS model & dimensi sama) ──────────────────
AQSHA_EMBEDDING_API_KEY=sk-CHANGEME
# AQSHA_EMBEDDING_BASE_URL=https://gateway.example/v1
# AQSHA_RAG_EMBEDDING_MODEL=text-embedding-3-small

# ── Tool riset & enrichment (semua opsional tapi FIRECRAWL disarankan) ─────────
# Firecrawl: scrape URL generik (worker url-ingestion, reader Explore, tool read_url agent).
FIRECRAWL_API_KEY=fc-CHANGEME
# OPENALEX_API_KEY=
# UNPAYWALL_EMAIL=you@example.com
# AQSHA_CONTACT_EMAIL=you@example.com
# SEMANTIC_SCHOLAR_API_KEY=
# CROSSREF_MAILTO=you@example.com

# ── OCR (Mistral) — PDF hasil scan & gambar; kosong = ekstraksi gambar nonaktif
#    dengan pesan jelas (bukan crash) ──────────────────────────────────────────
# MISTRAL_API_KEY=
# MISTRAL_OCR_MODEL=mistral-ocr-latest

# ── Billing / Mayar ────────────────────────────────────────────────────────────
# MAYAR_SERVER: "production" (api.mayar.id) atau "sandbox" (api.mayar.club) — key BEDA.
# Webhook TIDAK ditandatangani Mayar → otentisitas via secret di path:
# POST /webhooks/mayar/<MAYAR_WEBHOOK_SECRET>. Detail: apps/api/MAYAR-SETUP.md.
MAYAR_SERVER=production
MAYAR_API_KEY=CHANGEME
MAYAR_WEBHOOK_SECRET=CHANGEME
# Opsional: id produk membership induk (health-check /billing/products/sync) +
# id membershipTier per plan (fallback reverse-map webhook by productId).
# MAYAR_MEMBERSHIP_PRODUCT_ID=
# MAYAR_STARTER_MONTHLY_TIER_ID=
# MAYAR_STARTER_YEARLY_TIER_ID=
# MAYAR_PLUS_MONTHLY_TIER_ID=
# MAYAR_PLUS_YEARLY_TIER_ID=
# MAYAR_ULTRA_MONTHLY_TIER_ID=
# MAYAR_ULTRA_YEARLY_TIER_ID=

# ── Admin override (capacity check + kredit unlimited) ─────────────────────────
# Owner-id Clerk (user_xxx) dan/atau email, pisah koma.
# AQSHA_ADMIN_OWNER_USER_IDS=user_xxx
# AQSHA_ADMIN_EMAILS=you@example.com
