# ══════════════════════════════════════════════════════════════════════════════
# Aqsha — konfigurasi produksi. Sumber kebenaran secret/config = INFISICAL
# (project `aqsha`, https://secrets.aqshara.com). File ini bukan lagi "tempel semua
# ke Dokploy" — ia peta: mana yang di Dokploy, mana yang di Infisical.
#
# Runbook lengkap + owner checklist: docs/ops/secrets/infisical-strategy.md
# Deploy end-to-end: DEPLOYMENT.md. Dev lokal: apps/*/.env.example + infra/compose.dev.yaml.
#
# Alur: image entrypoint (infra/infisical-entrypoint.sh) menukar machine-identity → token,
# lalu `infisical run` menyuntik secret folder /app ke proses app (web/api/worker/agent/migrate).
# Stock image (postgres/redis/minio) tak bisa jalankan CLI → creds-nya tetap ${VAR} Dokploy.
# ══════════════════════════════════════════════════════════════════════════════


# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║ BAGIAN A — DI DOKPLOY (tab Environment service Compose). Hanya ini.            ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ── A1. Bootstrap Infisical (WAJIB) — machine identity `dokploy-prod`, read folder /app ──
# Kosong = entrypoint fallback jalankan app langsung TANPA secret (app crash di prod).
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_API_URL=https://secrets.aqshara.com
INFISICAL_ENV=prod                                 # dev | staging | prod

# ── A2. Kredensial infra untuk STOCK IMAGE (WAJIB) — dibaca compose ${VAR}, bukan lewat Infisical ──
# NILAI HARUS SAMA dengan yang direferensi Infisical /app (DATABASE_URL/REDIS_URL/S3_*).
POSTGRES_PASSWORD=changeme_strong_password
REDIS_PASSWORD=changeme_redis_password
MINIO_ROOT_USER=aqsha
MINIO_ROOT_PASSWORD=changeme_minio_password        # min 8 karakter
# MINIO_BUCKET=aqsha
# Ekspos Postgres ke host (port 5435) untuk Drizzle Studio/psql via Tailscale.
# Default 127.0.0.1 = tidak terekspos. JANGAN pernah 0.0.0.0.
# POSTGRES_BIND_IP=100.x.y.z

# ── A3. Image tag (opsional) ───────────────────────────────────────────────────
# IMAGE_TAG=latest                          # `sha-<short>` untuk pin/rollback ke commit tertentu

# ── A5. Isolasi stack STAGING (JANGAN diset di prod — default = nilai prod) ────
# Stack staging = Compose service Dokploy kedua, branch `staging`, compose.yaml sama.
# Project name mem-prefix semua volume + network → dua stack tak berbagi apa pun.
# Runbook: DEPLOYMENT.md → Staging.
# AQSHA_PROJECT_NAME=aqsha-staging
# POSTGRES_HOST_PORT=5436                   # 5435 dipakai stack prod
# IMAGE_TAG=staging                         # rollback staging: sha-<short>-staging


# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║ BAGIAN B — DI INFISICAL, folder /build (di-bake ke image web SAAT BUILD di CI). ║
# ║ Diambil deploy.yml via Infisical/secrets-action (machine identity `gh-actions`).║
# ╚══════════════════════════════════════════════════════════════════════════════╝
# NEXT_PUBLIC_* di-inline ke bundle klien → mengubahnya butuh REBUILD image web (push main).
NEXT_PUBLIC_API_URL=https://api.aqshara.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_CHANGEME
# NEXT_PUBLIC_SITE_URL=https://aqshara.com          # URL kanonik (SEO), tanpa trailing slash
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/1   # DSN klien web (kosong = SDK no-op)
# SENTRY_ORG=your-org                                # utk upload source-map saat build
# SENTRY_PROJECT_WEB=aqsha-web
# SENTRY_AUTH_TOKEN=sntrys_...                       # secret; kosong = upload source-map dilewati


# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║ BAGIAN C — DI INFISICAL, folder /deploy (dipakai CI job `deploy`).             ║
# ╚══════════════════════════════════════════════════════════════════════════════╝
# DOKPLOY_URL=https://dokploy.example.com
# DOKPLOY_API_KEY=...                                # Dokploy → profile → API key
# DOKPLOY_COMPOSE_ID=...                             # id service Compose


# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║ BAGIAN D — DI INFISICAL, folder /app (disuntik runtime ke app oleh entrypoint). ║
# ║ TIDAK ditempel ke Dokploy. Daftar di bawah = dokumentasi nilai yang harus ada. ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ── D1. Wiring internal — Infisical SECRET REFERENCE dot-notation ke /infra (jangan tulis password 2x) ──
# Sintaks: ${<env>.<folder>.<KEY>} — prefix env HARUS sama dengan environment folder /app ini (prod).
# DATABASE_URL=postgresql://aqsha:${prod.infra.POSTGRES_PASSWORD}@postgres:5432/aqsha
# REDIS_URL=redis://:${prod.infra.REDIS_PASSWORD}@redis:6379
# S3_ACCESS_KEY_ID=${prod.infra.MINIO_ROOT_USER}
# S3_SECRET_ACCESS_KEY=${prod.infra.MINIO_ROOT_PASSWORD}
# S3_BUCKET=aqsha
# URL PUBLIK MinIO (presigned URL mewarisi host ini → WAJIB terjangkau browser, bukan minio:9000).
S3_ENDPOINT=https://assets.aqshara.com

# ── D2. Clerk (satu app dibagi web + api + agent) ──────────────────────────────
CLERK_SECRET_KEY=sk_live_CHANGEME
CLERK_WEBHOOK_SIGNING_SECRET=whsec_CHANGEME          # endpoint POST /webhooks/clerk
# Agent (Mastra server.auth) verifikasi JWKS dari publishable key — samakan dgn NEXT_PUBLIC_* di /build.
CLERK_PUBLISHABLE_KEY=pk_live_CHANGEME

# ── D3. Model LLM utama (OpenAI / gateway OpenAI-compatible) ───────────────────
# Dipakai agent (chat Astra + /deep), api (/blocknote-ai doc-AI), worker (judul thread).
OPENAI_API_KEY=sk-CHANGEME
# OPENAI_BASE_URL=https://gateway.example/v1        # gateway/LiteLLM; tanpa Responses API → *_REASONING_EFFORT=off
AQSHA_LITE_MODEL=gpt-5.4-mini
# AQSHA_PRO_MODEL=gpt-5.1              # kosong → fallback Lite + billing turun ke rate Lite
# AQSHA_LITE_CONTEXT_WINDOW=128000
# AQSHA_PRO_CONTEXT_WINDOW=200000
# AQSHA_LITE_REASONING_EFFORT=low      # minimal|low|medium|high|xhigh|off
# AQSHA_PRO_REASONING_EFFORT=high
# AQSHA_REASONING_SUMMARY=auto         # auto|concise|detailed
# AQSHA_TITLE_MODEL=gpt-4o-mini        # auto-title thread (worker)

# ── D4. Fast model (typeahead /explore/suggest) — instance murah terpisah ──────
AQSHA_FAST_MODEL_API_KEY=sk-CHANGEME
# AQSHA_FAST_MODEL_BASE_URL=https://gateway.example/v1
# AQSHA_FAST_MODEL=gpt-4o-mini

# ── D5. RAG embedding (index + search HARUS model & dimensi sama) ──────────────
AQSHA_EMBEDDING_API_KEY=sk-CHANGEME
# AQSHA_EMBEDDING_BASE_URL=https://gateway.example/v1
# AQSHA_RAG_EMBEDDING_MODEL=text-embedding-3-small

# ── D6. Tool riset & enrichment (opsional, FIRECRAWL disarankan) ───────────────
FIRECRAWL_API_KEY=fc-CHANGEME
# OPENALEX_API_KEY=
# UNPAYWALL_EMAIL=you@example.com
# AQSHA_CONTACT_EMAIL=you@example.com
# SEMANTIC_SCHOLAR_API_KEY=
# CROSSREF_MAILTO=you@example.com

# ── D7. OCR (Mistral) — kosong = ekstraksi gambar nonaktif (bukan crash) ───────
# MISTRAL_API_KEY=
# MISTRAL_OCR_MODEL=mistral-ocr-latest

# ── D8. Sentry runtime DSN (opsional; kosong = SDK no-op) — console observability harian ──
# Error tracking + structured logs (Sentry Logs) + cron monitoring, per project. DSN terisi otomatis
# mengaktifkan: bridge selected logs (api/worker Pino facade + agent `logOps`) & check-in cron
# feed-hydration. Trace LLM TIDAK ke sini — itu milik Langfuse (D9). Lihat docs/ops/observability/cicd-runbook.md.
# SENTRY_DSN_WEB=https://xxx@oXXX.ingest.sentry.io/1     # web (server-side)
# SENTRY_DSN_API=https://xxx@oXXX.ingest.sentry.io/2     # api + worker (dibedakan tag process)
# SENTRY_DSN_AGENT=https://xxx@oXXX.ingest.sentry.io/3   # agent (Mastra)
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0                            # 0 = error+logs only (hemat kuota; server tracing off)

# ── D9. Langfuse (observability agent, opsional) ───────────────────────────────
# LANGFUSE_PUBLIC_KEY=pk-lf-CHANGEME
# LANGFUSE_SECRET_KEY=sk-lf-CHANGEME
# LANGFUSE_BASE_URL=https://langfuse.aqshara.com

# ── D10. Observability agent (opsional) ────────────────────────────────────────
# AQSHA_OBSERVABILITY=off               # kill-switch SEMUA exporter Mastra (storage + Langfuse); kosong = aktif

# ── D11. Billing / Mayar ───────────────────────────────────────────────────────
MAYAR_SERVER=production                 # production (api.mayar.id) | sandbox (api.mayar.club) — key BEDA
MAYAR_API_KEY=CHANGEME
MAYAR_WEBHOOK_SECRET=CHANGEME           # otentisitas via path: POST /webhooks/mayar/<secret>
# MAYAR_MEMBERSHIP_PRODUCT_ID=
# MAYAR_STARTER_MONTHLY_TIER_ID=
# MAYAR_STARTER_YEARLY_TIER_ID=
# MAYAR_PLUS_MONTHLY_TIER_ID=
# MAYAR_PLUS_YEARLY_TIER_ID=
# MAYAR_ULTRA_MONTHLY_TIER_ID=
# MAYAR_ULTRA_YEARLY_TIER_ID=

# ── D12. Admin override (capacity check + kredit unlimited) ────────────────────
# AQSHA_ADMIN_OWNER_USER_IDS=user_xxx    # id Clerk, pisah koma
# AQSHA_ADMIN_EMAILS=you@example.com

# ── D13. Waitlist double opt-in via Resend (API runtime; secret di Infisical /app) ──
RESEND_API_KEY=re_CHANGEME
WAITLIST_FROM_EMAIL=Aqsha <hello@aqshara.com>
PUBLIC_SITE_URL=https://aqshara.com
