{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Paket workspace yang diekspor sebagai TypeScript mentah (mis. `@aqsha/chat-core`) harus dapat
    // di-resolve loader ESM Node, yang menuntut ekstensi eksplisit pada import relatif.
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "forceConsistentCasingInFileNames": true
  }
}
