# Salin ke apps/web/.env.local. Saat dev, web menunjuk ke api lokal (:3001);
# api sendiri yang menjangkau Postgres/Redis VPS via Tailscale.
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL kanonik situs (SEO: metadataBase, robots, sitemap, OG). Tanpa trailing slash.
# Dev boleh http://localhost:3000; prod = domain asli. SSOT: lib/seo-config.ts.
NEXT_PUBLIC_SITE_URL=https://aqshara.com

# Clerk (Fase 1) — nilai sama dengan apps/web (V2 berbagi Clerk app yang sama).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_CHANGEME
CLERK_SECRET_KEY=sk_test_CHANGEME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# Astra chat (eve). Agent kini app TERPISAH `@aqsha/agent` (lihat apps/agent/.env.example
# untuk DATABASE_URL/CLERK/model/dll). web cuma mem-proxy same-origin `/eve/v1/*` → AGENT_ORIGIN
# via Next `rewrites()` (next.config). Server-side env (bukan NEXT_PUBLIC). Dev = port 4317.
AGENT_ORIGIN=http://localhost:4317
