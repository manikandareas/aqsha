# Salin ke apps/web/.env.local. Saat dev, web menunjuk ke api lokal (:3001);
# api sendiri yang menjangkau Postgres/Redis VPS via Tailscale.
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL kanonik situs (SEO: metadataBase, robots, sitemap, OG). Tanpa trailing slash.
# Dev boleh http://localhost:3000; prod = domain asli. SSOT: lib/seo-config.ts.
NEXT_PUBLIC_SITE_URL=https://aqshara.com

# Clerk (Fase 1) — nilai sama dengan apps/web (V2 berbagi Clerk app yang sama).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_CHANGEME
CLERK_SECRET_KEY=sk_test_CHANGEME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# Astra chat (Mastra). Agent = app TERPISAH `@aqsha/agent` (server Mastra; lihat
# apps/agent/.env.example untuk DATABASE_URL/CLERK/model/dll). web mem-proxy same-origin
# `/mastra-api/*` → MASTRA_AGENT_ORIGIN (FE pakai `@mastra/client-js`). Server-side env (bukan
# NEXT_PUBLIC). Dev = port 4111 (`mastra dev`); prod compose = http://agent:4317.
MASTRA_AGENT_ORIGIN=http://localhost:4111

# Agentation — toolbar feedback visual DEV-ONLY (komponen `AgentationDevToolbar`).
# Hanya render saat NODE_ENV=development; anotasi disinkron ke server lokal
# `agentation-mcp` yang dibaca Claude Code lewat MCP. Kosongkan = default :4747.
# NEXT_PUBLIC_AGENTATION_ENDPOINT=http://localhost:4747

# Feature flag Citation Manager (tab Sitasi workspace, rollout §10). Build-time:
# `true` = GA untuk semua user; kosong/`false` = hanya internal (isAdmin) yang lihat.
# NEXT_PUBLIC_FEATURE_WORKSPACE_CITATIONS=true
