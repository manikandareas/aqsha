{
  "name": "@aqsha/api-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "start": "bun run src/server.ts",
    "worker": "bun run --watch src/workers/index.ts",
    "worker:start": "bun run src/workers/index.ts",
    "seed:feed": "bun run scripts/seed-feed.ts",
    "test": "bun test --timeout 30000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aqsha/db": "workspace:*",
    "@aqsha/services": "workspace:*",
    "@clerk/backend": "^3.7.0",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/eden": "^1.4.9",
    "@elysiajs/openapi": "^1.4.15",
    "bullmq": "^5.79.0",
    "elysia": "^1.4.29",
    "ioredis": "^5.11.1",
    "rate-limiter-flexible": "^11.2.0"
  },
  "devDependencies": {
    "bun-types": "^1.3.13",
    "typescript": "^6.0.3"
  }
}
