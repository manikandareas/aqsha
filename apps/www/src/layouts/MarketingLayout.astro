---
import BaseLayout from "@/layouts/BaseLayout.astro";
import LandingFooter from "@/components/marketing/landing-footer.astro";
import { LandingHeader } from "@/components/marketing/landing-header";

type Props = {
  title?: string;
  description?: string;
  path?: string;
  ogType?: string;
};

const props = Astro.props as Props;
---

{/*
  Header as a sibling island — don't wrap <slot /> in a React island.
  Astro slot + nested client components in one parent often fail to hydrate.
  Footer is static Astro (no JS).
*/}
<BaseLayout {...props}>
  <LandingHeader client:load />
  <div class="min-h-[90vh]">
    <slot />
  </div>
  <LandingFooter />
</BaseLayout>
