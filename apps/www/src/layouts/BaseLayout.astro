---
import "@/styles/globals.css";
import { Agentation } from "agentation";
import { htmlLang, siteName, defaultDescription, siteUrl } from "@/lib/seo-config";

type Props = {
  title?: string;
  description?: string;
  path?: string;
  ogType?: string;
};

const { title, description = defaultDescription, path = "/", ogType = "website" } =
  Astro.props as Props;

const pageTitle = title ? `${title} | ${siteName}` : siteName;
const canonical = `${siteUrl}${path === "/" ? "" : path}`;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? siteName} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:image" content={`${siteUrl}/web-app-manifest-512x512.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? siteName} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/web-app-manifest-192x192.png" type="image/png" />
    {/*
      Preload the two faces that carry actual reading text: Nunito Sans
      (--font-heading) and Inter (--font-sans). Measured on the landing page,
      these start at ~35ms here versus ~128ms when left for CSS to discover.

      Caveat (--font-hand, 73KB) and JetBrains Mono (--font-mono, 40KB) do also
      render above the fold — doodle notes and button keycap glyphs — but they
      stay lazily discovered on purpose: 113KB of decorative faces competing
      with the LCP image costs more than the brief `font-display: swap` fallback
      on a keycap. Subsetting them to the glyphs actually used would be the real
      fix, and is a separate job.
    */}
    <link
      rel="preload"
      href="/fonts/nunito-sans-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      // Anti-flash theme init — key must match components/theme-toggle.tsx.
      (() => {
        try {
          const stored = localStorage.getItem("aqsha-www-theme");
          const dark = stored
            ? stored === "dark"
            : matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.classList.toggle("dark", dark);
          document.documentElement.style.colorScheme = dark ? "dark" : "light";
        } catch {
          /* no-op */
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-svh bg-background text-foreground antialiased">
    <slot />
    {import.meta.env.DEV && <Agentation client:only="react" />}
  </body>
</html>
