---
import {
  InstagramIcon,
  ThreadsIcon,
  TiktokIcon,
  XSocialIcon,
} from "@/components/icons";
import { ThemeToggle } from "@/components/theme-toggle";
import { appUrl } from "@/lib/app-url";

/* Sosial: href masih "#" sampai akun resminya ada. */
const socialLinks = [
  { label: "X", href: "#", Icon: XSocialIcon },
  { label: "Threads", href: "#", Icon: ThreadsIcon },
  { label: "TikTok", href: "#", Icon: TiktokIcon },
  { label: "Instagram", href: "#", Icon: InstagramIcon },
] as const;

const jumpLinks = [
  { label: "Bandingin", href: "/#bandingin" },
  { label: "Cara kerja", href: "/#cara-kerja" },
  { label: "Fitur", href: "/#fitur" },
  { label: "About", href: "/#cerita-pembuat" },
] as const;

const linkColumns = [
  [
    { label: "Beranda", href: "/" },
    { label: "Harga", href: "/#pricing" },
    { label: "Blog", href: "/blog" },
    { label: "Apa yang baru", href: "/changelog" },
  ],
  [
    { label: "Masuk", href: appUrl("/sign-in") },
    { label: "Coba gratis", href: appUrl("/sign-up") },
  ],
] as const;

const year = new Date().getFullYear();

/* Rumput pixel organik — di-generate deterministik saat build (seeded PRNG)
   supaya coraknya acak seperti referensi tapi stabil antar build. */
function mulberry32(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = mulberry32(20260719);
const PX = 4;
const TILE_W = 240;
const TILE_H = 44;
const GRASS_BASE_Y = 32;

type GrassPixel = { x: number; y: number; c: "a" | "b" | "c" | "d" };
const grassPixels: GrassPixel[] = [];

// Tepian atas: makin ke bawah makin rapat, tone makin dalam.
for (let x = 0; x < TILE_W; x += PX) {
  for (let y = 0; y < GRASS_BASE_Y; y += PX) {
    const density = y < 12 ? 0.08 : y < 20 ? 0.22 : y < 28 ? 0.48 : 0.78;
    if (rand() >= density) continue;
    const r = rand();
    const c =
      y < 16
        ? r < 0.35
          ? "a"
          : r < 0.8
            ? "b"
            : "c"
        : r < 0.12
          ? "a"
          : r < 0.5
            ? "b"
            : r < 0.9
              ? "c"
              : "d";
    grassPixels.push({ x, y, c });
  }
}

// Bercak terang/gelap di dalam hamparan solid.
for (let x = 0; x < TILE_W; x += PX) {
  for (let y = GRASS_BASE_Y; y < TILE_H; y += PX) {
    const r = rand();
    if (r < 0.13) grassPixels.push({ x, y, c: r < 0.045 ? "a" : "d" });
  }
}
---

<footer class="w-full bg-background">
  <div
    class="mx-auto w-full max-w-6xl px-4 pb-20 pt-20 sm:px-6 sm:pt-24 lg:px-8 lg:pb-24 lg:pt-28"
  >
    <div
      class="grid grid-cols-1 items-start gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,21rem)] lg:gap-20"
    >
      {/* ——— Kolom kiri: headline, link, meta ——— */}
      <div class="min-w-0">
        <h2
          class="font-heading text-balance text-4xl font-medium leading-[1.08] tracking-normal sm:text-5xl"
        >
          <span class="block text-foreground">Nulis riset bareng AI</span>
          <span class="block text-muted-foreground">
            yang sumbernya beneran ada
          </span>
        </h2>

        <nav aria-label="Langsung ke bagian" class="mt-12 sm:mt-14">
          <p class="flex flex-wrap items-baseline gap-x-5 gap-y-2">
            <span class="text-sm text-muted-foreground">Langsung ke</span>
            {
              jumpLinks.map((link) => (
                <a
                  href={link.href}
                  class="text-sm font-medium text-foreground/85 transition-colors hover:text-foreground"
                >
                  {link.label}
                </a>
              ))
            }
          </p>
        </nav>

        <nav aria-label="Halaman" class="mt-9">
          <div class="grid max-w-md grid-cols-2 gap-x-10">
            {
              linkColumns.map((column) => (
                <ul class="space-y-3">
                  {column.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        class="text-sm leading-snug text-foreground/85 transition-colors hover:text-foreground"
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              ))
            }
          </div>
        </nav>

        <div class="mt-10">
          <ThemeToggle client:visible variant="labeled" />
        </div>

        <p
          class="mt-12 flex flex-wrap items-center gap-x-1.5 gap-y-2 text-sm text-muted-foreground"
        >
          Tiap jawaban dengan
          <span
            class="inline-flex items-center gap-1 rounded-full border-2 bg-mint-soft px-2.5 py-0.5 text-xs font-medium text-mint-foreground [border-color:var(--mint-soft-border)]"
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              class="size-3"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M4 12.5 L10 18.5 L20 6"></path>
            </svg>
            sitasi kecek
          </span>
          ke paper aslinya
        </p>
        <p class="mt-3 text-sm text-muted-foreground">
          Copyright © {year} Aqsha
        </p>

        <p class="font-hand mt-10 text-xl text-foreground/60 sm:text-2xl">
          dicek, baru dipercaya
        </p>
      </div>

      {/* ——— Kolom kanan: kartu ilustrasi + CTA ——— */}
      <aside
        class="w-full max-w-[19rem] rounded-3xl border-2 border-border bg-card p-2 shadow-soft-card sm:max-w-[21rem] lg:justify-self-end"
      >
        <div class="relative overflow-hidden rounded-2xl">
          <img
            src="/landing/workspace-view.webp"
            alt="Meja kerja pixel art dengan laptop dan kopi, menghadap jendela ke ladang bunga matahari"
            width="1122"
            height="1402"
            loading="lazy"
            decoding="async"
            class="block h-auto w-full"
          />

          {/* Tombol sosial kaca terpisah — band token supaya kontras stabil di dua mode. */}
          <nav
            aria-label="Media sosial Aqsha"
            class="absolute inset-x-3 bottom-3 flex items-center justify-evenly"
          >
            {
              socialLinks.map(({ label, href, Icon }) => (
                <a
                  href={href}
                  aria-label={label}
                  class="inline-flex size-11 items-center justify-center rounded-xl text-band-ink backdrop-blur-md transition-colors [background:color-mix(in_srgb,var(--band)_72%,transparent)] hover:[background:color-mix(in_srgb,var(--band)_88%,transparent)]"
                >
                  <Icon size={19} aria-hidden />
                </a>
              ))
            }
          </nav>
        </div>
      </aside>
    </div>
  </div>

  {/* ——— Strip rumput pixel ——— */}
  <div class="footer-grass" aria-hidden="false">
    <svg aria-hidden="true" class="block h-11 w-full">
      <defs>
        <pattern
          id="footer-grass-px"
          width={TILE_W}
          height={TILE_H}
          patternUnits="userSpaceOnUse"
        >
          <rect
            x="0"
            y={GRASS_BASE_Y}
            width={TILE_W}
            height={TILE_H - GRASS_BASE_Y}
            class="gpx-c"></rect>
          {
            grassPixels.map((p) => (
              <rect x={p.x} y={p.y} width={PX} height={PX} class={`gpx-${p.c}`} />
            ))
          }
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#footer-grass-px)"></rect>
    </svg>
    <div class="grass-band px-4 py-2.5 text-center">
      <p
        class="grass-ink inline-flex flex-wrap items-center justify-center gap-x-1.5 text-sm"
      >
        Dibikin dengan
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class="size-4"
          style="fill: var(--coral)"
        >
          <path
            d="M12 21 C 7 16.5, 3 13, 3 8.8 C 3 6, 5.2 4, 7.8 4 C 9.5 4, 11 4.9, 12 6.3 C 13 4.9, 14.5 4, 16.2 4 C 18.8 4, 21 6, 21 8.8 C 21 13, 17 16.5, 12 21 Z"
          ></path>
        </svg>
        <span class="sr-only">love</span>
        oleh Manika Technologies
      </p>
    </div>
  </div>
</footer>

<style>
  /* Empat tone rumput ala pixel-art: a paling terang → d paling dalam.
     Dark pakai nilai eksplisit — token gelapnya achromatic (hue 0) sehingga
     color-mix di oklch menyeret hijau ke arah coklat. */
  .footer-grass {
    --grass-a: oklch(0.965 0.025 130);
    --grass-b: oklch(0.88 0.1 132);
    --grass-c: oklch(0.81 0.125 135);
    --grass-d: oklch(0.71 0.135 140);
  }
  :global(.dark) .footer-grass {
    --grass-a: oklch(0.58 0.07 135);
    --grass-b: oklch(0.47 0.09 138);
    --grass-c: oklch(0.4 0.08 140);
    --grass-d: oklch(0.33 0.07 142);
  }
  .gpx-a {
    fill: var(--grass-a);
  }
  .gpx-b {
    fill: var(--grass-b);
  }
  .gpx-c {
    fill: var(--grass-c);
  }
  .gpx-d {
    fill: var(--grass-d);
  }
  .grass-band {
    background: linear-gradient(180deg, var(--grass-c), var(--grass-d));
  }
  .grass-ink {
    color: oklch(0.3 0.06 140);
  }
  :global(.dark) .grass-ink {
    color: oklch(0.93 0.02 130);
  }
</style>
