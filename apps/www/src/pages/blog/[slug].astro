---
import "@/styles/prose.css";

import MarketingLayout from "@/layouts/MarketingLayout.astro";
import { BlogPostHeader } from "@/components/blog/blog-post-header";
import { mdxComponents } from "@/components/mdx-components";
import { mapBlogEntry } from "@/lib/blog/map";
import { blogColumn, blogGutter } from "@/lib/blog/layout";
import { siteUrl } from "@/lib/seo-config";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts
    .filter((p) => !p.data.draft)
    .map((post) => ({
      params: { slug: post.id.replace(/\.mdx$/, "") },
      props: { post },
    }));
}

const { post } = Astro.props;
const mapped = mapBlogEntry(post, post.body ?? "");
const { Content } = await render(post);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${siteUrl}${mapped.url}#article`,
  mainEntityOfPage: { "@type": "WebPage", "@id": `${siteUrl}${mapped.url}` },
  headline: mapped.title,
  description: mapped.excerpt,
  datePublished: mapped.publishedAt,
  dateModified: mapped.updated ?? mapped.publishedAt,
  inLanguage: "id-ID",
  url: `${siteUrl}${mapped.url}`,
  ...(mapped.cover ? { image: `${siteUrl}${mapped.cover}` } : {}),
  ...(mapped.author
    ? { author: { "@type": "Person", name: mapped.author } }
    : {}),
  publisher: { "@id": `${siteUrl}/#organization` },
};
---

<MarketingLayout
  title={mapped.title}
  description={mapped.excerpt}
  path={mapped.url}
  ogType="article"
>
  <main class={`${blogColumn} py-14 sm:py-20`}>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
    <div class={blogGutter}>
      <BlogPostHeader post={mapped} />
      <article class="aqsha-prose blog-prose mt-10 sm:mt-12">
        <Content components={mdxComponents} />
      </article>
    </div>
  </main>
</MarketingLayout>
