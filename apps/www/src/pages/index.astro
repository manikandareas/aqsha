---
import BaseLayout from "@/layouts/BaseLayout.astro";
import LandingFooter from "@/components/marketing/landing-footer.astro";
import WhatsNewTeaserSection from "@/components/marketing/whats-new-teaser-section.astro";
import { AudienceMarqueeSection } from "@/components/marketing/audience-marquee-section";
import { BottomCtaSection } from "@/components/marketing/bottom-cta-section";
import { FaqSection } from "@/components/marketing/faq-section";
import { FeatureBlocksSection } from "@/components/marketing/feature-blocks-section";
import { FounderStorySection } from "@/components/marketing/founder-story-section";
import { LandingHeroZone } from "@/components/marketing/landing-hero-zone";
import { PricingSection } from "@/components/marketing/pricing-section";
import { StructuredData } from "@/components/marketing/structured-data";
import { WhyAqshaSection } from "@/components/marketing/why-aqsha-section";
import { mapChangelogEntry } from "@/lib/changelog/map";
import { mapLandingLatest } from "@/lib/marketing/latest";
import { getCollection } from "astro:content";

const entries = (await getCollection("changelog"))
  .filter((e) => !e.data.draft)
  .sort(
    (a, b) =>
      b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
  )
  .map((e) => mapChangelogEntry(e));

const { teaserLatest } = mapLandingLatest(entries[0] ?? null);
---

{/*
  Astro owns the page graph; React owns interactive widgets only.
  client:load  — above-the-fold chrome + hero
  client:visible — below-fold motion / pricing / FAQ
  static Astro — teaser (CSS motion) + footer (no JS)

  `rootMargin` on every below-fold island: Locomotive lerps the scroll, so a
  section observed at the exact viewport edge hydrates at the same moment its
  entrance animation should already be playing, and the reveal gets clipped.
  Hydrating 300px early costs nothing extra — the same chunks, just fetched
  before the section is on screen — and lets the animation start on time.

  Comment form matters: an HTML comment ships to every response, this
  expression-style one does not. Never write the closing marker inside the
  body either — it terminates the comment early and leaks the rest as text.
*/}
<BaseLayout
  title="Workspace riset dan karya tulis untuk mahasiswa"
  description="Aqsha menyatukan proyek karya tulis, dokumen Typst, referensi, dan Astra supaya risetmu bergerak menjadi draf yang siap direview."
  path="/"
>
  <main class="min-h-svh bg-background text-foreground">
    <StructuredData />
    <LandingHeroZone client:load />
    <AudienceMarqueeSection client:visible={{ rootMargin: "300px" }} />
    <WhyAqshaSection client:visible={{ rootMargin: "300px" }} />
    <WhatsNewTeaserSection latest={teaserLatest} />
    <FeatureBlocksSection client:visible={{ rootMargin: "300px" }} />
    <FounderStorySection client:visible={{ rootMargin: "300px" }} />
    <PricingSection client:visible={{ rootMargin: "300px" }} />
    <FaqSection client:visible={{ rootMargin: "300px" }} />
    <BottomCtaSection client:visible={{ rootMargin: "300px" }} />
    <LandingFooter />
  </main>
</BaseLayout>

<script>
  import "locomotive-scroll/locomotive-scroll.css";
  import { initLandingSmoothScroll } from "@/lib/marketing/smooth-scroll";

  initLandingSmoothScroll();
</script>
