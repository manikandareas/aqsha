---
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import { WaitlistPanel } from "@/components/waitlist/waitlist-panel";
---

<MarketingLayout
  title="Akses awal Aqsha"
  description="Daftar waitlist untuk mendapatkan kabar saat Aqsha, workspace riset dan penulisan berbasis proyek, membuka akses awal."
  path="/waitlist"
>
  <main class="w-full overflow-x-clip bg-background">
    <div class="mx-auto w-full max-w-6xl px-5 py-14 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
      <WaitlistPanel client:load />
    </div>
  </main>
</MarketingLayout>
