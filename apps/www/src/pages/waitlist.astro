---
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import { WaitlistForm } from "@/components/waitlist/waitlist-form";
---

<MarketingLayout
  title="Akses awal Aqsha"
  description="Daftar waitlist untuk mendapatkan kabar saat Aqsha, workspace riset dan penulisan berbasis proyek, membuka akses awal."
  path="/waitlist"
>
  <main class="mx-auto w-full max-w-xl px-5 py-14 sm:px-6 sm:py-20 lg:px-8">
    <header class="mb-10">
      <h1 class="font-heading text-[1.9rem] font-medium leading-tight text-foreground sm:text-[2.25rem]">
        Masuk daftar akses awal Aqsha
      </h1>
      <p class="mt-3 max-w-md text-sm leading-6 text-muted-foreground sm:text-base">
        Tinggalkan email untuk mengonfirmasi pendaftaran. Kami akan mengabarimu saat
        Aqsha siap dibuka—bukan untuk mengirim newsletter marketing.
      </p>
    </header>
    <WaitlistForm client:load />
  </main>
</MarketingLayout>
