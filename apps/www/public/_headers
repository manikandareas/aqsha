# Cloudflare Pages cache policy.
#
# /_astro/* is content-hashed by the build and /fonts/* filenames are stable and
# only ever replaced wholesale, so both are safe to freeze for a year.
# /landing/* is NOT hashed — an art swap reuses the filename — so it gets a
# short freshness window and serves stale while revalidating in the background.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/landing/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
