# Salin ke apps/web-v2/.env.local. Saat dev, web-v2 menunjuk ke api-v2 lokal (:3001);
# api-v2 sendiri yang menjangkau Postgres/Redis VPS via Tailscale.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Clerk (Fase 1) — nilai sama dengan apps/web (V2 berbagi Clerk app yang sama).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_CHANGEME
CLERK_SECRET_KEY=sk_test_CHANGEME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app
