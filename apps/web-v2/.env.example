# Salin ke apps/web-v2/.env.local. Saat dev, web-v2 menunjuk ke api-v2 lokal (:3001);
# api-v2 sendiri yang menjangkau Postgres/Redis VPS via Tailscale.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Clerk (Fase 1) — nilai sama dengan apps/web (V2 berbagi Clerk app yang sama).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_CHANGEME
CLERK_SECRET_KEY=sk_test_CHANGEME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# Fase 6 (Astra chat via eve). `withEve` men-spawn PROSES eve (Node terpisah) yang
# meng-import langsung: ia butuh DATABASE_URL untuk proyeksi chat (chat_threads/
# chat_messages) + CLERK_SECRET_KEY (di atas) untuk verifikasi token channel.
# Nilai DATABASE_URL = sama dengan api-v2 (Postgres VPS via Tailscale).
DATABASE_URL=postgresql://aqsha:aqsha@100.x.x.x:5432/aqsha

# Provider model Astra (OpenAI / gateway OpenAI-compatible). Owner set saat E2E.
OPENAI_API_KEY=sk-CHANGEME
# OPENAI_BASE_URL=https://gateway.example/v1   # opsional (LiteLLM/gateway)
AQSHA_LITE_MODEL=gpt-4o
