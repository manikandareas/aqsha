# Salin ke apps/agent-v2/.env. Agent Astra (eve) = proses Node TERPISAH yang meng-import
# @aqsha/services + @aqsha/db in-process, jadi butuh env backend yang SAMA dengan api-v2
# (kecuali billing/Polar + PORT api). Arahkan DATABASE_URL/REDIS_URL ke host yang sama
# dengan api-v2.

# Datastore (store proyeksi chat + semua service + enqueue BullMQ thread-title).
DATABASE_URL=postgresql://aqsha:CHANGEME@vps-aqsha.tailnet.ts.net:5432/aqsha
REDIS_URL=redis://:CHANGEME@vps-aqsha.tailnet.ts.net:6379

# Clerk (channel eve `clerkAuth()` verifikasi bearer via @clerk/backend.verifyToken).
# Nilai SAMA dengan api-v2/web (V2 berbagi Clerk app).
CLERK_SECRET_KEY=sk_test_CHANGEME

# Provider model Astra (OpenAI / gateway OpenAI-compatible). Owner set saat E2E.
OPENAI_API_KEY=sk-CHANGEME
# OPENAI_BASE_URL=https://gateway.example/v1   # opsional (LiteLLM/gateway)
AQSHA_LITE_MODEL=gpt-4o
# WAJIB bila AQSHA_LITE_MODEL = id KUSTOM yang tak dikenal katalog AI Gateway eve (mis.
# model lewat LiteLLM seperti `openai/deepseek/...`). Tanpa ini eve gagal compile compaction
# & tak boot. Isi context window (token) model. Kosongkan bila pakai model yang eve kenal
# (mis. gpt-4o → eve resolve sendiri). Contoh deepseek/gpt-4o = 128000.
AQSHA_LITE_CONTEXT_WINDOW=128000

# Tool riset (search_web/arxiv/papers/lookup_doi). Opsional tapi disarankan.
FIRECRAWL_API_KEY=fc-CHANGEME
JINA_API_KEY=
OPENALEX_API_KEY=
CROSSREF_MAILTO=you@example.com

AQSHA_CONTACT_EMAIL=you@example.com
UNPAYWALL_EMAIL=you@example.com
SEMANTIC_SCHOLAR_API_KEY=

# RAG embedding (search_thread_documents + persist research_sources). DISAMAKAN dengan
# api-v2/V1 supaya index = search.
AQSHA_EMBEDDING_API_KEY=sk-CHANGEME
# AQSHA_EMBEDDING_BASE_URL=https://gateway.example/v1
AQSHA_RAG_EMBEDDING_MODEL=text-embedding-3-small
AQSHA_RAG_EMBEDDING_DIMENSION=1536

# Object storage (save_url / propose_artifact menyimpan blob via StorageService). SAMA
# dengan api-v2 (MinIO self-hosted; forcePathStyle dipaksa di klien).
S3_ENDPOINT=http://vps-aqsha.tailnet.ts.net:9000   # port 9000 = API
S3_ACCESS_KEY_ID=CHANGEME                          # = MINIO_ROOT_USER
S3_SECRET_ACCESS_KEY=CHANGEME                      # min 8 char
S3_BUCKET=aqsha
# S3_REGION=us-east-1
