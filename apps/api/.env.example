API_PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aqsha
WEB_ORIGIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-at-least-32-characters

ASTRA_USER_ID=local-user
ASTRA_WORKSPACE=local
ASTRA_MODEL=gpt-5.2
ASTRA_ALLOWED_MODELS=gpt-5.2,gpt-5.2-pro,gpt-5.4,gpt-5.4-pro,gpt-5.4-mini,o3,o4-mini
OPENAI_REASONING_EFFORT=
OPENAI_REASONING_SUMMARY=
OPENAI_TEXT_VERBOSITY=
OPENAI_FORCE_REASONING=false
ASTRA_SKILLS_ROOTS=./skills
ASTRA_ENABLE_SKILL_SCRIPTS=false
ASTRA_SKILL_SCRIPT_RUNTIME=daytona
ASTRA_SKILL_SCRIPT_TIMEOUT_MS=30000
ASTRA_RESEARCH_ARTIFACT_DIR=.astra-artifacts
DAYTONA_API_KEY=
DAYTONA_API_URL=
DAYTONA_TARGET=
# Build apps/api/runtime/daytona-visual/Dockerfile and set this to the published image tag.
# The image must include Python 3.12, Matplotlib, and Pydantic.
DAYTONA_IMAGE=
ASTRA_EXA_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
