# Salin ke apps/api/.env (Bun auto-load saat dev:api). Arahkan DATABASE_URL/REDIS_URL
# ke Tailscale host VPS (atau localhost untuk dev fully-lokal).
DATABASE_URL=postgresql://aqsha:CHANGEME@vps-aqsha.tailnet.ts.net:5432/aqsha
REDIS_URL=redis://:CHANGEME@vps-aqsha.tailnet.ts.net:6379

PORT=3001

# Clerk (Fase 1). CLERK_SECRET_KEY = sama dengan apps/web (V2 berbagi Clerk app).
# CLERK_WEBHOOK_SIGNING_SECRET = secret per-endpoint dari Clerk dashboard untuk
# endpoint V2 POST /webhooks/clerk (registrasi terpisah dari webhook V1).
CLERK_SECRET_KEY=sk_test_CHANGEME
CLERK_WEBHOOK_SIGNING_SECRET=whsec_CHANGEME

# S3-compatible object storage (Fase 3). Default = MinIO self-hosted di infra/compose
# (S3-compatible; bisa juga diarahkan ke Cloudflare R2 / AWS S3 tanpa ubah kode).
# S3_ENDPOINT = http://<Tailscale-IP-VPS>:9000 (port API MinIO; bukan 9001/console).
# Kredensial = MINIO_ROOT_USER / MINIO_ROOT_PASSWORD di infra/.env. Satu bucket +
# prefix (artifacts/, papers/). forcePathStyle dipaksa di klien (wajib utk MinIO).
# CATATAN: presigned upload URL memakai host S3_ENDPOINT — browser yang upload harus
# bisa menjangkaunya (tailnet saat dev; expose via reverse-proxy/domain utk publik).
S3_ENDPOINT=http://100.x.y.z:9000
S3_ACCESS_KEY_ID=CHANGEME
S3_SECRET_ACCESS_KEY=CHANGEME
S3_BUCKET=aqsha
# Opsional; MinIO terima region apa saja, default us-east-1.
# S3_REGION=us-east-1

# RAG embedding (Fase 3). OpenAI-compatible; model+dimensi DISAMAKAN dengan V1
# supaya index P3 = search P6. Set AQSHA_EMBEDDING_BASE_URL untuk gateway/proxy.
AQSHA_EMBEDDING_API_KEY=sk-CHANGEME
# AQSHA_EMBEDDING_BASE_URL=https://gateway.example/v1
AQSHA_RAG_EMBEDDING_MODEL=text-embedding-3-small
AQSHA_RAG_EMBEDDING_DIMENSION=1536

# ── Fast model (Explore: saran kueri + subtopik Pulse + analisis Gap/Tension) ──
# Instance LLM murah TERPISAH, configurable penuh (OpenAI-compatible → bisa gpt-5-nano,
# gateway/LiteLLM, dsb). Dipakai route /explore/* + worker explore-analysis. Bila kosong,
# fallback ke OPENAI_API_KEY / OPENAI_BASE_URL (yang juga tak diset di api by default),
# jadi set di sini secara eksplisit.
AQSHA_FAST_MODEL_API_KEY=sk-CHANGEME
# AQSHA_FAST_MODEL_BASE_URL=https://gateway.example/v1
AQSHA_FAST_MODEL=gpt-4o-mini

# Metadata enrichment resolver (Fase 3, resolver-only — TANPA GROBID/LLM).
# OPENALEX_API_KEY opsional (mempercepat), UNPAYWALL_EMAIL/AQSHA_CONTACT_EMAIL
# dipakai sebagai mailto provider, SEMANTIC_SCHOLAR_API_KEY/JINA_API_KEY opsional.
OPENALEX_API_KEY=
UNPAYWALL_EMAIL=
AQSHA_CONTACT_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=
JINA_API_KEY=
# LLM metadata fallback ditunda (Fase 3 = resolver-only).
LLM_METADATA_ENABLED=false

# ── Billing / Mayar (Fase 5) ──────────────────────────────────────────────────
# MAYAR_SERVER: "sandbox" (default → api.mayar.club) atau "production"
# (api.mayar.id). MAYAR_API_KEY = Bearer JWT dari Mayar dashboard. Mayar TIDAK
# menandatangani webhook → otentisitas via secret di path:
# POST /webhooks/mayar/<MAYAR_WEBHOOK_SECRET> (constant-time compare). Buat 6
# produk Membership (Starter/Plus/Ultra × month/year) di dashboard → isi ID-nya.
MAYAR_SERVER=sandbox
MAYAR_API_KEY=CHANGEME
MAYAR_WEBHOOK_SECRET=CHANGEME
MAYAR_STARTER_MONTHLY_PRODUCT_ID=
MAYAR_STARTER_YEARLY_PRODUCT_ID=
MAYAR_PLUS_MONTHLY_PRODUCT_ID=
MAYAR_PLUS_YEARLY_PRODUCT_ID=
MAYAR_ULTRA_MONTHLY_PRODUCT_ID=
MAYAR_ULTRA_YEARLY_PRODUCT_ID=

# Admin override (Fase 5 — di-wire ke capacity check + unlimited credits). Owner-id
# Clerk (user_xxx; di V2 ownerUserId == clerkUserId == sub) dan/atau email, pisah koma.
# AQSHA_ADMIN_OWNER_USER_IDS=user_xxx
# AQSHA_ADMIN_EMAILS=you@example.com
