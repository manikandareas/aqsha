API_PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aqsha
WEB_ORIGIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-at-least-32-characters

ASTRA_USER_ID=local-user
ASTRA_WORKSPACE=local
ASTRA_MODEL=gpt-5.2
ASTRA_ALLOWED_MODELS=gpt-5.2,gpt-5.2-pro,gpt-5.4,gpt-5.4-pro,gpt-5.4-mini,o3,o4-mini
OPENAI_REASONING_EFFORT=
OPENAI_REASONING_SUMMARY=
OPENAI_TEXT_VERBOSITY=
OPENAI_FORCE_REASONING=false
ASTRA_SKILLS_ROOTS=./skills
ASTRA_EXA_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

ASTRA_TOTAL_TOKEN_BUDGET=200000
ASTRA_PLANNER_MODEL=
ASTRA_CRITIC_MODEL=
ASTRA_SEARCHER_MAX_CONCURRENCY=3
RUN_INTEGRATION_TESTS=false

# ───── Phase 2: external research tools ─────
# Cohere reranking (rerank_sources tool). Leave empty to fall back to no-op pass-through.
ASTRA_COHERE_API_KEY=
ASTRA_COHERE_RERANK_MODEL=rerank-v3.5
ASTRA_RERANK_TOP_N=8

# Shared HTTP fetch budget for arxiv / crossref / pubmed / fetch_url / pdf_extract.
ASTRA_FETCH_TIMEOUT_MS=15000
ASTRA_FETCH_MAX_BYTES=2500000
ASTRA_HTTP_USER_AGENT=AqshaResearchBot/1.0 (+https://aqsha.app/bot)

# Optional NCBI key — bumps PubMed rate limit from 3 → 10 req/s.
ASTRA_PUBMED_API_KEY=

# Optional CrossRef polite-pool email. Strongly recommended in production.
ASTRA_CROSSREF_MAILTO=
