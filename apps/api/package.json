{
  "name": "@aqsha/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./auth": "./src/auth.ts",
    "./eden": "./src/eden.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "db:generate": "bunx drizzle-kit generate --config=./drizzle.config.ts",
    "db:migrate": "bunx drizzle-kit migrate --config=./drizzle.config.ts",
    "db:studio": "bunx drizzle-kit studio --config=./drizzle.config.ts",
    "db:check": "bun run src/database/check.ts",
    "lint": "eslint .",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^1.0.39",
    "@ai-sdk/openai": "^3.0.58",
    "@ai-sdk/provider-utils": "^4.0.26",
    "@aqsha/db": "workspace:*",
    "@aqsha/shared": "workspace:*",
    "@daytona/sdk": "^0.171.0",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/eden": "^1.4.9",
    "@elysiajs/openapi": "^1.4.14",
    "@t3-oss/env-core": "^0.13.11",
    "@types/node": "^25.6.0",
    "ai": "^6.0.168",
    "better-auth": "^1.6.9",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "elysia": "^1.4.28",
    "pg": "^8.20.0",
    "sharp": "^0.34.5",
    "uploadthing": "^7.7.4",
    "vega": "^6.2.0",
    "vega-lite": "^6.4.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.5"
  }
}
