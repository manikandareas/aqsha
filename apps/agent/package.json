{
  "name": "@aqsha/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "skills:gen": "bun run scripts/gen-inline-skills.ts",
    "dev": "bun run skills:gen && mastra dev --dir src/mastra",
    "build": "bun run skills:gen && mastra build --dir src/mastra",
    "start": "node .mastra/output/index.mjs",
    "typecheck": "bun run skills:gen && tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.0-beta.74",
    "@aqsha/chat-core": "workspace:*",
    "@aqsha/db": "workspace:*",
    "@aqsha/services": "workspace:*",
    "@clerk/backend": "^3.7.0",
    "@mastra/ai-sdk": "^1.6.0",
    "@mastra/auth-clerk": "^1.2.1",
    "@mastra/core": "^1.47.0",
    "@mastra/langfuse": "^1.4.3",
    "@mastra/memory": "^1.21.2",
    "@mastra/observability": "^1.15.2",
    "@mastra/pg": "^1.14.2",
    "ai": "7.0.0-beta.178",
    "postgres": "^3.4.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "mastra": "^1.16.0",
    "typescript": "^5"
  }
}
