# Salin ke apps/agent/.env. Agent Astra (Mastra) = server Node TERPISAH yang meng-import
# @aqsha/services + @aqsha/db in-process, jadi butuh env backend yang SAMA dengan api
# (kecuali billing/Mayar + PORT api). Arahkan DATABASE_URL/REDIS_URL ke host yang sama
# dengan api.

# Datastore (Mastra storage/vector `mastra_*` + proyeksi tipis chat_threads + semua service +
# enqueue BullMQ thread-title).
DATABASE_URL=postgresql://aqsha:CHANGEME@vps-aqsha.tailnet.ts.net:5432/aqsha
REDIS_URL=redis://:CHANGEME@vps-aqsha.tailnet.ts.net:6379

# Clerk. Runtime Mastra (MastraAuthClerk) verifikasi bearer via JWKS → WAJIB publishableKey
# (jwksUri diturunkan dari publishableKey; override pakai CLERK_JWKS_URI bila perlu).
# `userContextMiddleware` verifikasi bearer via @clerk/backend.verifyToken (secretKey) untuk
# ekstrak email (gate admin). Semua nilai SAMA dengan api/web (berbagi Clerk app).
CLERK_SECRET_KEY=sk_test_CHANGEME
CLERK_PUBLISHABLE_KEY=pk_test_CHANGEME
# CLERK_JWKS_URI=https://<frontend-api>.clerk.accounts.dev/.well-known/jwks.json

# Provider model Astra (OpenAI / gateway OpenAI-compatible). Owner set saat E2E.
# Astra memakai OpenAI Responses API (`.responses`) supaya ringkasan penalaran (reasoning summary)
# model GPT-5 ter-stream ke UI sebagai blok berpikir. Pakai model reasoning-capable (GPT-5 family).
OPENAI_API_KEY=sk-CHANGEME
# OPENAI_BASE_URL=https://gateway.example/v1   # opsional (LiteLLM/gateway). CATATAN: bila gateway tak
# mendukung Responses API, set AQSHA_*_REASONING_EFFORT=off (model jalan tanpa trace penalaran).
AQSHA_LITE_MODEL=gpt-5.4-mini
# AQSHA_PRO_MODEL=gpt-5.1            # model tier Pro (reasoning lebih dalam). Kosong → fallback ke Lite.
# Penalaran (Responses API). Effort: minimal|low|medium|high|xhigh, atau `off` untuk mematikan
# (mis. model non-penalaran gpt-4o / gateway tanpa Responses). Lite default `low`, Pro default `high`.
# AQSHA_LITE_REASONING_EFFORT=low
# AQSHA_PRO_REASONING_EFFORT=high
# AQSHA_REASONING_SUMMARY=auto      # auto|concise|detailed — bentuk ringkasan penalaran yang dirender.
# Jendela context (token) model Lite — dipakai `TokenLimiterProcessor` (batas input ~75%).
# Default 128000 bila kosong. Mastra tak meresolve katalog model, jadi set sesuai model gateway.
AQSHA_LITE_CONTEXT_WINDOW=128000

# Tool riset (search_web/arxiv/papers/lookup_doi). Opsional tapi disarankan.
FIRECRAWL_API_KEY=fc-CHANGEME
JINA_API_KEY=
OPENALEX_API_KEY=
CROSSREF_MAILTO=you@example.com

AQSHA_CONTACT_EMAIL=you@example.com
UNPAYWALL_EMAIL=you@example.com
SEMANTIC_SCHOLAR_API_KEY=

# RAG embedding (search_thread_documents + persist research_sources). DISAMAKAN dengan
# api/V1 supaya index = search.
AQSHA_EMBEDDING_API_KEY=sk-CHANGEME
# AQSHA_EMBEDDING_BASE_URL=https://gateway.example/v1
AQSHA_RAG_EMBEDDING_MODEL=text-embedding-3-small
AQSHA_RAG_EMBEDDING_DIMENSION=1536

# Object storage (save_url / propose_artifact menyimpan blob via StorageService). SAMA
# dengan api (MinIO self-hosted; forcePathStyle dipaksa di klien).
S3_ENDPOINT=http://vps-aqsha.tailnet.ts.net:9000   # port 9000 = API
S3_ACCESS_KEY_ID=CHANGEME                          # = MINIO_ROOT_USER
S3_SECRET_ACCESS_KEY=CHANGEME                      # min 8 char
S3_BUCKET=aqsha
# S3_REGION=us-east-1
