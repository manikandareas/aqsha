		"@myriaddreamin/typst.ts": "0.7.0",
		"@sentry/sveltekit": "^10.65.0",
		"@svelte-put/qr": "2.1.3",
		"@tanstack/svelte-query": "6.1.36",
		"@vedivad/codemirror-typst": "0.18.8",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"codemirror": "^6.0.2",
		"date-fns": "4.4.0",
		"mermaid": "^11.15.0",
		"mode-watcher": "^1.1.0",
		"pdfjs-dist": "5.4.296",
		"svelte-clerk": "1.1.10",
		"svelte-dnd-action": "^0.9.61",
		"svelte-sonner": "^1.1.1",
		"svelte-streamdown": "3.1.2",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
