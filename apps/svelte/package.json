{
	"name": "@aqsha/svelte",
	"private": true,
	"version": "0.1.0",
	"license": "AGPL-3.0-only",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"content": "content-collections build",
		"build": "content-collections build && vite build",
		"start": "node build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "content-collections build && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"typecheck": "content-collections build && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "content-collections build && vitest --run",
		"test:unit": "vitest",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@content-collections/cli": "0.1.9",
		"@content-collections/core": "0.15.2",
		"@content-collections/markdown": "0.1.4",
		"@content-collections/vite": "0.3.0",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/caveat": "^5.2.8",
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@fontsource-variable/nunito-sans": "^5.2.7",
		"@playwright/test": "^1.60.0",
		"@shikijs/rehype": "4.3.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"jsdom": "^28.0.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"rehype-autolink-headings": "7.1.0",
		"rehype-slug": "6.0.0",
		"remark-gfm": "4.0.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"unist-util-visit": "5.1.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@aqsha/api": "workspace:*",
		"@aqsha/chat-core": "workspace:*",
		"@aqsha/ui-svelte": "workspace:*",
		"@clerk/themes": "2.4.57",
		"@codemirror/commands": "^6.8.1",
		"@codemirror/language": "^6.11.0",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/state": "^6.5.2",
		"@codemirror/view": "^6.38.1",
		"@hugeicons/core-free-icons": "^4.2.2",
		"@hugeicons/svelte": "^1.1.4",
		"@internationalized/date": "^3.12.2",
		"@mastra/client-js": "1.28.0",
