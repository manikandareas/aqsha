# apps/svelte env. Semua nilai runtime dibaca via $env/dynamic/* (§3.7) — Infisical menyuntik saat
# container start, JANGAN $env/static/*. Divalidasi zod saat boot (fail-fast) di $lib/server/env.
# Copy ke `.env` untuk local dev. Prefix PUBLIC_ = boleh masuk client bundle; sisanya server-only.

# ── Clerk (svelte-clerk membaca ini via $env/dynamic/*). Dev instance keys, shared dgn apps/web. ──
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx          # wajib, diawali "pk_"
CLERK_SECRET_KEY=sk_test_xxx                       # wajib (server-only), diawali "sk_"
PUBLIC_CLERK_SIGN_IN_URL=/sign-in
PUBLIC_CLERK_SIGN_UP_URL=/sign-up
PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# ── Aqsha API (Eden Treaty) base URL. ──
PUBLIC_API_URL=http://localhost:3001               # wajib, URL valid

# ── Mastra agent origin untuk proxy streaming /mastra-api/* (server-only). ──
MASTRA_AGENT_ORIGIN=http://localhost:4111          # URL valid (default localhost:4111)

# ── Sentry (opsional; DSN kosong → SDK no-op). Nilai dari Infisical di env deployed. ──
PUBLIC_SENTRY_DSN=                                 # DSN client (browser); kosong = disabled
PUBLIC_SENTRY_ENVIRONMENT=development              # environment client (default: production)
SENTRY_DSN=                                        # DSN server (server-only); kosong = disabled
SENTRY_ENVIRONMENT=development                     # environment server (default: production)
SENTRY_TRACES_SAMPLE_RATE=0                         # [0,1], invalid → 0 (kuota)
SENTRY_RELEASE=                                     # di-inject CI (= GIT_COMMIT); kosong = unset

# ── Sentry source-map upload (BUILD-time saja, dibaca vite.config.ts via process.env; opsional). ──
# Ketiganya harus ada agar sentrySvelteKit plugin meng-upload + hapus source map saat build.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
