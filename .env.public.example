# Aqsha public landing stack — copy ONLY Bagian A to Dokploy's Environment tab.
# Runtime application secrets stay in the existing Infisical project's `/public` namespace, documented in
# docs/ops/public-launch-runbook.md.

# A1. Infisical bootstrap for the least-privileged `dokploy-public` machine identity.
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_API_URL=https://secrets.aqshara.com
INFISICAL_ENV=prod
INFISICAL_SECRET_PATH=/public/app

# A2. Stock infrastructure images cannot read Infisical directly. These values must match
# the references in Infisical /public/app.
POSTGRES_DB=aqsha_public
POSTGRES_USER=aqsha_public
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# A3. Compose identity and image selection.
AQSHA_PROJECT_NAME=aqsha-public
IMAGE_TAG=latest
