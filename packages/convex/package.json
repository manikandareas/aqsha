{
  "name": "@aqsha/convex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./api": {
      "types": "./convex/_generated/api.d.ts",
      "default": "./convex/_generated/api.js"
    },
    "./server": {
      "types": "./convex/_generated/server.d.ts",
      "default": "./convex/_generated/server.js"
    },
    "./prompt-commands": {
      "types": "./convex/agent/prompt/promptCommands.ts",
      "default": "./convex/agent/prompt/promptCommands.ts"
    },
    "./artifact-upload-limits": {
      "types": "./convex/artifacts/uploadLimits.ts",
      "default": "./convex/artifacts/uploadLimits.ts"
    },
    "./artifact-upload-policy": {
      "types": "./convex/artifacts/uploadPolicy.ts",
      "default": "./convex/artifacts/uploadPolicy.ts"
    },
    "./billing-catalog": {
      "types": "./convex/billing/catalog.ts",
      "default": "./convex/billing/catalog.ts"
    },
    "./explore": {
      "types": "./convex/explore/model.ts",
      "default": "./convex/explore/model.ts"
    },
    "./feed": {
      "types": "./convex/feed/model.ts",
      "default": "./convex/feed/model.ts"
    },
    "./hitl-tool-names": {
      "types": "./convex/agent/hitl/hitlToolNames.ts",
      "default": "./convex/agent/hitl/hitlToolNames.ts"
    },
    "./mention-markers": {
      "types": "./convex/agent/context/mentionMarkers.ts",
      "default": "./convex/agent/context/mentionMarkers.ts"
    }
  },
  "scripts": {
    "dev": "convex dev",
    "codegen": "convex codegen",
    "deploy": "convex deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc -p convex && eslint . --report-unused-disable-directives --max-warnings 0",
    "logs": "convex logs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.63",
    "@daytona/sdk": "^0.186.0",
    "@convex-dev/polar": "^0.9.1",
    "@convex-dev/rag": "^0.7.5",
    "@convex-dev/rate-limiter": "^0.3.2",
    "ai": "^6.0.177",
    "convex": "^1.38.0",
    "exa-js": "^2.12.1",
    "fast-xml-parser": "^5.7.3",
    "mammoth": "^1.12.0",
    "standardwebhooks": "^1.0.0",
    "unpdf": "^1.6.2",
    "yaml": "^2.6.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^1.2.2",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "convex-test": "^0.0.51",
    "eslint": "^9.39.4",
    "globals": "^17.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
