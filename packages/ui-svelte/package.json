{
	"name": "@aqsha/ui-svelte",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "Aqsha design-system components for Svelte 5 (raw-source, shadcn-svelte based)",
	"svelte": "./src/index.ts",
	"exports": {
		".": {
			"svelte": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./components/*": {
			"svelte": "./src/components/*/index.ts",
			"default": "./src/components/*/index.ts"
		},
		"./utils": "./src/utils.ts",
		"./recipes": "./src/recipes.ts",
		"./styles/tokens.css": "./src/styles/tokens.css",
		"./styles/components.css": "./src/styles/components.css"
	},
	"scripts": {
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@hugeicons/core-free-icons": "^4.2.2",
		"@hugeicons/svelte": "^1.1.4",
		"@internationalized/date": "^3.12.2",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"embla-carousel-svelte": "^8.6.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"vaul-svelte": "1.0.0-next.7"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"prettier": "^3.9.5",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3"
	}
}
