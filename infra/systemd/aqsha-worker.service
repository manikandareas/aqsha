# Aqsha worker — BullMQ consumers (feed-hydration 3h cron, metadata enrichment,
# account-deletion). No public port. Runtime: Bun. Shares api-v2.env (same DB/Redis/keys).
[Unit]
Description=Aqsha worker (BullMQ)
After=network-online.target aqsha-api-v2.service
Wants=network-online.target

[Service]
Type=simple
User=aqsha
WorkingDirectory=/srv/aqsha
EnvironmentFile=/etc/aqsha/api-v2.env
ExecStart=/usr/local/bin/bun run start:worker
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
