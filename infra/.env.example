# Compose infra (di VPS). Salin ke infra/.env lalu isi nilainya.
# BIND_HOST = IP Tailscale VPS, supaya Postgres/Redis/MinIO hanya terekspos di tailnet.
BIND_HOST=100.x.y.z
POSTGRES_PASSWORD=changeme_strong_password
REDIS_PASSWORD=changeme_redis_password

# MinIO (object storage S3-compatible). ROOT_USER/PASSWORD = kredensial admin yang
# dipakai api-v2 sebagai S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY. MINIO_BUCKET dibuat
# otomatis saat startup oleh service `minio-init`. Password minimal 8 karakter.
MINIO_ROOT_USER=aqsha
MINIO_ROOT_PASSWORD=changeme_minio_password
MINIO_BUCKET=aqsha
